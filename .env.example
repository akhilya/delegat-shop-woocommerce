# Public origin of this shop (no trailing slash).
# Local default matches PUBLISH_PORT. On Dokploy use https://woo.your.domain
SITE_URL=http://localhost:8088

# Host port mapped to container 80.
# On Dokploy leave as a high unused port; Traefik still targets container 80.
# Do not set this to 80 (conflicts with Dokploy Traefik).
PUBLISH_PORT=8088

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=wordpress

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_TITLE=Delegat WooCommerce shop

# Paste this key into the Delegat workspace connection.
DELEGAT_API_KEY=delegat-woo-sandbox-api-key-local
